{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelf",
  "version": "0.1.0",
  "identifier": "app.shelf.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Shelf",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/Steam/**",
          "$HOME/Library/Application Support/Highball/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
